{
  "buildCommand": "npm run build:static",
  "outputDirectory": "dist/static",
  "framework": null,
  "functions": {
    "api/-seed.js": {
      "memory": 512,
      "maxDuration": 60
    },
    "api/-*.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
